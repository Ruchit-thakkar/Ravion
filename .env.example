# ========================================================
# RAVION — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy these values into .env before running the application.
# ========================================================

# Application Port (Default 3000 for Next.js)
PORT=3000

# Canonical Site URL (for SEO, Open Graph & Sitemap generation)
NEXT_PUBLIC_SITE_URL=https://ravion.in

# MongoDB Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB=ravion

# ImageKit Cloud Storage (for portfolio images and videos)
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# Primary Administrator Credentials (used for initial provisioning if DB is empty)
ADMIN_EMAIL=admin@ravion.in
ADMIN_PASSWORD=choose-a-strong-unique-password

# JWT Authentication Secret (generate with: openssl rand -base64 32)
JWT_SECRET=generate-a-long-random-secret-key-32-chars-minimum

# Optional: Transactional Email Notifications for New Inquiries
# NOTIFICATION_EMAIL=admin@ravion.in
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@ravion.in
# SMTP_PASS=your-smtp-password
